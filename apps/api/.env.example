IS_LOCAL=true
ENVIRONMENT=dev
APP_NAME=contentos
AWS_REGION=ap-south-1

# Supabase (local & QA share this pattern)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password
DB_SSL=true
DATABASE_URL=postgresql://postgres:URL_ENCODE_PASSWORD_HERE@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
# If password has @ # / etc, either URL-encode it in DATABASE_URL or rely on DB_* fields (preferred — app encodes automatically)

JWT_SECRET=local-dev-jwt-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-min-32

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024

# Google Gemini — text/planning (chat, plan, score, insights).
# Set AI_PROVIDER=gemini to default, or pick it in the Agent UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Amazon Bedrock — text (Converse) + optional image models (Titan / Nova Canvas / SDXL).
# On Lambda, IAM already allows bedrock:InvokeModel — set BEDROCK_ENABLED=true.
# Locally: AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (or AWS_PROFILE) + BEDROCK_ENABLED=true.
# Enable each foundation model under Bedrock → Model access in your account/region.
BEDROCK_ENABLED=false
BEDROCK_REGION=
BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# Optional model id overrides for Agent image dropdown:
# BEDROCK_TITAN_MODEL=amazon.titan-image-generator-v2:0
# BEDROCK_NOVA_CANVAS_MODEL=amazon.nova-canvas-v1:0
# BEDROCK_SDXL_MODEL=stability.stable-diffusion-xl-v1
# BEDROCK_STABLE_IMAGE_MODEL=stability.stable-image-core-v1:0

# Optional third-party image models (Agent dropdown)
# IDEOGRAM_API_KEY=
# RECRAFT_API_KEY=

PUBLIC_API_URL=http://localhost:4001

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4001/api/social/linkedin/callback
LINKEDIN_FRONTEND_REDIRECT=http://localhost:5173/connections/linkedin
# Optional Marketing/Community Management API version header (YYYYMM)
# LINKEDIN_API_VERSION=202506
# Company pages need Community Management product + w_organization_social / r_organization_admin

S3_BUCKET_NAME=contentos-files-dev

# ── Email delivery (OTP + snapshots) ──────────────────────────────────────
# A) Gmail SMTP (real inbox, local/dev):
#    EMAIL_TRANSPORT=smtp
#    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=true
#    SMTP_USER=you@gmail.com   SMTP_PASSWORD=<Google App Password>
#    SMTP_FROM=you@gmail.com   SES_FROM_EMAIL=you@gmail.com
# B) Amazon SES (QA/prod):
#    EMAIL_TRANSPORT=ses  SES_ENABLED=true  SES_FROM_EMAIL=noreply@yourdomain.com
#    + AWS credentials with ses:SendEmail
# C) Local catcher (no real mail):
#    EMAIL_TRANSPORT=local  → http://127.0.0.1:4001/dev/mailbox
#    or Mailpit: EMAIL_TRANSPORT=smtp SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_TLS=false

EMAIL_TRANSPORT=smtp
SES_ENABLED=false
SES_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Passwordless email OTP (Wave 1)
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=6
OTP_RATE_LIMIT_PER_EMAIL=5
OTP_RATE_LIMIT_PER_IP=20
OTP_RATE_WINDOW_SECONDS=900
# OTP_PEPPER=
