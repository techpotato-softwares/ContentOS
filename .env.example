# ContentOS — copy to apps/api/.env for local API
# Local + QA use the same Supabase Postgres (SSL required)

IS_LOCAL=true
ENVIRONMENT=dev
APP_NAME=contentos
AWS_REGION=ap-south-1

# Supabase (local & QA)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password
DB_SSL=true
DATABASE_URL=postgresql://postgres:your-supabase-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require

JWT_SECRET=local-dev-jwt-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-min-32

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4001/api/social/linkedin/callback
LINKEDIN_FRONTEND_REDIRECT=http://localhost:5173/connections/linkedin

S3_BUCKET_NAME=contentos-files-dev
VITE_API_URL=http://localhost:4001
